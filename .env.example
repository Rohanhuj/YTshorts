# Copy this file to .env for local development. Never commit .env.
# Phase 0 uses mock providers and does not require any real credential.

MOCK_MODE=true
PUBLISHING_ENABLED=false

# Paid content providers (leave blank until an authorized integration phase)
OPENAI_API_KEY=
RUNWAYML_API_SECRET=
USDA_API_KEY=

# AWS via GitHub Actions OIDC (Phase 2; do not add long-lived AWS access keys)
AWS_ROLE_ARN=
AWS_REGION=us-west-2
S3_BUCKET=
DYNAMODB_TABLE=

# YouTube OAuth (Phase 6; keep these in the protected publishing environment)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Non-secret runtime configuration
PUBLISH_TIMEZONE=America/Los_Angeles
MONTHLY_BUDGET_USD=45.00
